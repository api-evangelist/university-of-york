              "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<element>\n  <responseDate>2026-06-04T03:12:55Z</responseDate>\n  <request>https://etheses.whiterose.ac.uk/cgi/oai2</request>\n  <Identify>\n    <repositoryName>White Rose eTheses Online</repositoryName>\n    <baseURL>https://etheses.whiterose.ac.uk/cgi/oai2</baseURL>\n    <protocolVersion>2.0</protocolVersion>\n    <adminEmail>etheses@whiterose.ac.uk</adminEmail>\n    <earliestDatestamp>2010-02-12T15:42:31Z</earliestDatestamp>\n    <deletedRecord>persistent</deletedRecord>\n    <granularity>YYYY-MM-DDThh:mm:ssZ</granularity>\n  </Identify>\n  <GetRecord>\n    <record>\n      <header>\n        <identifier>oai:etheses.whiterose.ac.uk:411</identifier>\n        <datestamp>(string)</datestamp>\n        <status>(string)</status>\n        <setSpec>(string)</setSpec>\n        <setSpec>(string)</setSpec>\n      </header>\n      <metadata>\n        <dc>\n          <title>(string)</title>\n          <title>(string)</title>\n          <creator>(string)</creator>\n          <creator>(string)</creator>\n          <subject>(string)</subject>\n          <subject>(string)</subject>\n          <description>(string)</description>\n          <description>(string)</description>\n          <relation>(string)</relation>\n          <relation>(string)</relation>\n          <date>(string)</date>\n          <date>(string)</date>\n          <type>(string)</type>\n          <type>(string)</type>\n          <identifier>(string)</identifier>\n          <identifier>(string)</identifier>\n        </dc>\n      </metadata>\n    </record>\n  </GetRecord>\n  <ListRecords>\n    <record>\n      <header>\n        <identifier>oai:etheses.whiterose.ac.uk:411</identifier>\n        <datestamp>(string)</datestamp>\n        <status>(string)</status>\n        <setSpec>(string)</setSpec>\n        <setSpec>(string)</setSpec>\n      </header>\n      <metadata>\n        <dc>\n          <title>(string)</title>\n          <title>(string)</title>\n    